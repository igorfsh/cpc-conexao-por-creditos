# Desenvolvimento local
APP_PORT=3000
NODE_ENV=development

# URL pública da aplicação. No Render, use a URL onrender.com do serviço.
APP_BASE_URL=http://localhost:3000

# Banco MySQL persistente para produção (contas e Face ID/digital).
# Use DATABASE_URL=mysql://usuario:senha@host:porta/banco  OU as variáveis DB_* abaixo.
# DB_SSL=true para bancos na nuvem (TiDB Cloud, Aiven...); DB_SSL_CA só se o provedor fornecer um certificado (.pem).
DATABASE_URL=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=cpc
DB_SSL=false
DB_SSL_CA=
DB_CONNECTION_LIMIT=5
DB_TIMEOUT_MS=8000

# Sessão
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# IA (opcional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Facebook Login (developers.facebook.com → Login do Facebook)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://SEU-DOMINIO/auth/facebook/callback
# Opcional: fixa a versão da Graph API (ex.: v23.0). Vazio usa a versão padrão do app.
FACEBOOK_GRAPH_VERSION=

# LinkedIn (developer.linkedin.com → produto "Sign In with LinkedIn using OpenID Connect")
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=https://SEU-DOMINIO/auth/linkedin/callback

# Sign in with Apple / iCloud (developer.apple.com, exige HTTPS e domínio verificado)
APPLE_CLIENT_ID=br.seu.servico.web
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Conteúdo da chave .p8 (com \n no lugar das quebras de linha) OU caminho do arquivo
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=
APPLE_CALLBACK_URL=https://SEU-DOMINIO/auth/apple/callback

# Passkeys / WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000