<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Usuários — CPC</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="/css/dashboard.css">
  <style>
    .users-page { max-width: 1180px; margin: 0 auto; padding: 32px 24px; }
    .users-header { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 24px; }
    .users-header h1 { margin: 0; color: #1a1a1a; }
    .users-header p { margin: 6px 0 0; color: #777; }
    .users-table-wrap { overflow-x: auto; background: #fff; border-radius: 8px; box-shadow: 0 8px 24px rgba(24, 40, 34, .08); }
    .users-table { width: 100%; border-collapse: collapse; min-width: 760px; }
    .users-table th, .users-table td { padding: 14px 16px; border-bottom: 1px solid #edf0ee; text-align: left; white-space: nowrap; }
    .users-table th { color: #68736e; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
    .users-table td { color: #26312c; font-size: 14px; }
    .user-cell { display: flex; align-items: center; gap: 10px; }
    .user-avatar { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; background: #e1f5ee; display: grid; place-items: center; color: #0f6e56; font-weight: 600; }
    .tag { display: inline-block; padding: 4px 9px; border-radius: 999px; background: #edf7f2; color: #0f6e56; font-size: 12px; }
    .tag.local { background: #f3f4f2; color: #59615d; }
    .tag.inativo { background: #fbeceb; color: #a23b35; }
    .empty { padding: 28px; text-align: center; color: #777; }
  </style>
</head>
<body>
  <section class="topbar">
    <section class="topbar-left">
      <a class="topbar-logo" href="/"><img src="/img/logo-white.png" alt="CPC"><span>admin</span></a>
    </section>
    <nav class="topbar-nav side-menu">
      <ul><li><a href="/adm">Dashboard</a></li><li><a href="/adm/anuncios">Anúncios</a></li><li><a href="/adm/trocas">Trocas</a></li><li><a href="/adm/usuarios" class="active">Usuários</a></li></ul>
    </nav>
    <section class="topbar-right desktop-only-right"><span class="topbar-badge">● sistema ativo</span><section class="topbar-user"><%= usuarioLogado ? usuarioLogado.nome.charAt(0).toUpperCase() : 'A' %></section></section>
  </section>

  <main class="users-page">
    <header class="users-header"><section><h1>Usuários</h1><p><%= usuarios.length %> contas cadastradas no sistema CPC</p></section></header>
    <section class="users-table-wrap">
      <% if (!usuarios.length) { %>
        <p class="empty">Nenhum usuário cadastrado.</p>
      <% } else { %>
        <table class="users-table">
          <thead><tr><th>Usuário</th><th>E-mail</th><th>Provedor</th><th>Cadastro</th><th>Último login</th><th>Status</th></tr></thead>
          <tbody>
            <% usuarios.forEach(function(usuario) { %>
              <tr>
                <td><section class="user-cell"><% if (usuario.foto) { %><img class="user-avatar" src="<%= usuario.foto %>" alt=""><% } else { %><span class="user-avatar"><%= (usuario.nome || '?').charAt(0).toUpperCase() %></span><% } %><span><%= usuario.nome %></span></section></td>
                <td><%= usuario.email %></td>
                <td><span class="tag <%= (usuario.provider || 'local') === 'local' ? 'local' : '' %>"><%= usuario.provider || 'local' %></span></td>
                <td><%= usuario.dataCriacao ? new Date(usuario.dataCriacao).toLocaleDateString('pt-BR') : '—' %></td>
                <td><%= usuario.ultimoLogin ? new Date(usuario.ultimoLogin).toLocaleString('pt-BR') : '—' %></td>
                <td><span class="tag <%= usuario.status === 'inativo' ? 'inativo' : '' %>"><%= usuario.status || 'ativo' %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </section>
  </main>
</body>
</html>
