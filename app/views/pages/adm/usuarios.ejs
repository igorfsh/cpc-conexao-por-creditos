<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <%- include('../../partials/tema-inicial.ejs') %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Usuários — CPC Admin</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap">
  <link rel="icon" href="/img/logo-black.png">
  <link rel="stylesheet" href="/css/cpc-palette.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>

  <%- include('../../partials/adm-topbar', { ativo: 'usuarios' }) %>

  <% const admins = usuarios.filter(function(u) { return u.perfil === 'admin'; }).length; %>
  <main class="page adm-page">
    <header class="adm-header">
      <section>
        <p class="hero-label">gerenciar</p>
        <h1>Usuários</h1>
        <p class="adm-sub"><%= usuarios.length %> contas cadastradas no sistema CPC</p>
      </section>
    </header>

    <section class="adm-toolbar">
      <input type="search" class="adm-search" id="busca" placeholder="Buscar por nome ou e-mail…" aria-label="Buscar usuários">
      <section class="adm-chips" role="group" aria-label="Filtrar por perfil">
        <button type="button" class="chip active" data-filtro="">todos <span><%= usuarios.length %></span></button>
        <button type="button" class="chip" data-filtro="user">usuários <span><%= usuarios.length - admins %></span></button>
        <button type="button" class="chip" data-filtro="admin">admins <span><%= admins %></span></button>
      </section>
    </section>

    <section class="card adm-table-wrap">
      <% if (!usuarios.length) { %>
        <p class="empty">Nenhum usuário cadastrado.</p>
      <% } else { %>
        <table class="adm-table">
          <thead>
            <tr><th>Usuário</th><th>E-mail</th><th>Provedor</th><th>Cadastro</th><th>Último login</th><th>Status</th><th class="col-acoes">Ações</th></tr>
          </thead>
          <tbody>
            <% usuarios.forEach(function(usuario) {
                 const perfil = usuario.perfil || 'user';
                 const ehVoce = usuarioLogado && String(usuarioLogado.id) === String(usuario.id); %>
              <tr data-filtro="<%= perfil %>" data-busca="<%= [usuario.nome, usuario.email].join(' ').toLowerCase() %>">
                <td data-label="Usuário">
                  <section class="item-cell">
                    <% if (usuario.foto) { %><img class="user-avatar" src="<%= usuario.foto %>" alt=""><% } else { %><span class="user-avatar"><%= (usuario.nome || '?').charAt(0).toUpperCase() %></span><% } %>
                    <section>
                      <p class="item-title"><%= usuario.nome %><% if (ehVoce) { %> <small class="muted">(você)</small><% } %></p>
                      <% if (perfil === 'admin') { %><span class="tag tag-admin">admin</span><% } %>
                    </section>
                  </section>
                </td>
                <td data-label="E-mail"><%= usuario.email %></td>
                <td data-label="Provedor"><span class="tag <%= (usuario.provider || 'local') === 'local' ? 'tag-muted' : '' %>"><%= usuario.provider || 'local' %></span></td>
                <td data-label="Cadastro"><%= usuario.dataCriacao ? new Date(usuario.dataCriacao).toLocaleDateString('pt-BR') : '—' %></td>
                <td data-label="Último login"><%= usuario.ultimoLogin ? new Date(usuario.ultimoLogin).toLocaleString('pt-BR') : '—' %></td>
                <td data-label="Status"><span class="tag <%= usuario.status === 'inativo' ? 'tag-cancelada' : '' %>"><%= usuario.status || 'ativo' %></span></td>
                <td class="col-acoes">
                  <section class="row-actions">
                    <% if (perfil === 'admin' || ehVoce) { %>
                      <span class="muted">—</span>
                    <% } else { %>
                      <form action="/adm/usuarios/deletar/<%= usuario.id %>" method="POST" data-confirmar="Remover a conta de <%= usuario.nome %> (<%= usuario.email %>)? Os anúncios dessa pessoa serão desativados e a ação não pode ser desfeita.">
                        <button class="btn-reject" type="submit">remover conta</button>
                      </form>
                    <% } %>
                  </section>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <p class="empty" id="semResultado" hidden>Nenhum usuário corresponde ao filtro.</p>
      <% } %>
    </section>
  </main>

  <script src="/js/adm.js"></script>
</body>
</html>
