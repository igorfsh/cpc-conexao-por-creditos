<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <%- include('../../partials/tema-inicial.ejs') %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin — CPC</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap">
  <link rel="icon" href="/img/logo-black.png">
  <link rel="stylesheet" href="/css/cpc-palette.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>

  <%- include('../../partials/adm-topbar', { ativo: 'dashboard' }) %>

  <section class="page">
    <section class="grid">

      <!-- HERO -->
      <section class="card card-dark hero">
        <section class="hero-top">
          <section>
            <p class="hero-label">conexão por créditos</p>
            <p class="hero-title">Painel<br>admin</p>
          </section>
          <section class="status-pill">
            <span class="status-dot"></span>
            sistema ativo
          </section>
        </section>
        <p class="hero-meta">
          <%= new Date().toLocaleDateString('pt-BR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
        </p>
      </section>

      <!-- TROCAS HOJE -->
      <section class="card stat-card">
        <p class="stat-label">trocas hoje</p>
        <p class="stat-value"><%= trocasHoje %></p>
        <% if (deltaPercent === null) { %>
          <p class="stat-delta delta-neutral">sem trocas ontem</p>
        <% } else { %>
          <p class="stat-delta <%= deltaPercent >= 0 ? 'delta-up' : 'delta-down' %>"><%= deltaPercent >= 0 ? '+' : '' %><%= deltaPercent %>% vs. ontem</p>
        <% } %>
      </section>

      <!-- MEMBROS -->
      <section class="card stat-card">
        <p class="stat-label">membros ativos</p>
        <p class="stat-value"><%= stats.membrosAtivos.toLocaleString('pt-BR') %></p>
        <p class="stat-delta delta-neutral">+<%= novosEssaSemana %> esta semana</p>
      </section>

      <!-- ATALHOS / KPIs -->
      <a class="card kpi-card" href="/adm/trocas?status=pendente">
        <section class="bottom-icon" style="background:rgba(255,183,3,.18)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#184C3B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
        </section>
        <section>
          <p class="bottom-label">trocas pendentes</p>
          <p class="bottom-value"><%= trocasPendentes %></p>
        </section>
      </a>

      <a class="card kpi-card" href="/adm/anuncios">
        <section class="bottom-icon" style="background:var(--cpc-mint-pale)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#184C3B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-5"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </section>
        <section>
          <p class="bottom-label">anúncios ativos</p>
          <p class="bottom-value"><%= totalAnuncios.toLocaleString('pt-BR') %></p>
        </section>
      </a>

      <a class="card kpi-card" href="/adm/usuarios">
        <section class="bottom-icon" style="background:var(--cpc-mint-pale)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#184C3B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
        </section>
        <section>
          <p class="bottom-label">novos hoje</p>
          <p class="bottom-value"><%= novosHoje %> <small>de <%= totalUsuarios %> contas</small></p>
        </section>
      </a>

      <section class="card kpi-card">
        <section class="bottom-icon" style="background:var(--cpc-mint-pale)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#184C3B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </section>
        <section>
          <p class="bottom-label">doações acumuladas</p>
          <p class="bottom-value"><%= doacoes %></p>
        </section>
      </section>

      <!-- ATIVIDADE POR HORA -->
      <section class="card">
        <section class="sec-title">atividade por hora</section>
        <section class="bars">
          <% atividade.forEach(function(h) { %>
            <section class="bar" style="--bar-height: <%= h %>%; --bar-color: <%= h >= 75 ? 'var(--cpc-primary-light)' : h >= 45 ? 'var(--cpc-sage)' : h >= 20 ? 'var(--cpc-mint)' : 'var(--cpc-mint-pale)' %>"></section>
          <% }) %>
        </section>
        <section class="bars-labels">
          <span>00h</span><span>06h</span><span>12h</span><span>18h</span><span>24h</span>
        </section>
        <section class="bar-peak">
          <p>horário de pico</p>
          <strong><%= picoFaixa %></strong>
          <small><%= picoDia %> trocas nesse intervalo</small>
        </section>
      </section>

      <!-- ÚLTIMAS TROCAS -->
      <section class="card span-2">
        <section class="sec-title">
          últimas trocas
          <a href="/adm/trocas">ver todas</a>
        </section>
        <% ultimasTrocas.forEach(function(t) { %>
          <section class="feed-item">
            <span class="feed-dot" style="--dot-color: <%= t.status === 'concluida' ? '#2A7D63' : t.status === 'cancelada' ? '#e07a73' : '#FFB703' %>"></span>
            <span class="feed-title"><%= t.anuncioTitulo %></span>
            <span class="feed-user"><%= t.solicitanteNome %></span>
            <span class="tag tag-<%= t.status %>"><%= t.status %></span>
            <span class="feed-time"><%= t.data %></span>
          </section>
        <% }) %>
        <% if (ultimasTrocas.length === 0) { %>
          <p class="empty-inline">Nenhuma troca ainda</p>
        <% } %>
      </section>

      <!-- CATEGORIAS -->
      <section class="card">
        <section class="sec-title">por categoria <a href="/adm/anuncios">gerenciar</a></section>
        <section class="cat-row">
          <section class="cat-header"><span>alimentos</span><strong><%= catAlimentos %>%</strong></section>
          <section class="cat-track"><section class="cat-fill" style="--cat-width: <%= catAlimentos %>%; background: #2A7D63"></section></section>
        </section>
        <section class="cat-row">
          <section class="cat-header"><span>profissionais</span><strong><%= catProfissionais %>%</strong></section>
          <section class="cat-track"><section class="cat-fill" style="--cat-width: <%= catProfissionais %>%; background: var(--cpc-sage)"></section></section>
        </section>
        <section class="cat-row">
          <section class="cat-header"><span>infantil</span><strong><%= catInfantil %>%</strong></section>
          <section class="cat-track"><section class="cat-fill" style="--cat-width: <%= catInfantil %>%; background: #FFB703"></section></section>
        </section>
        <section class="cat-row">
          <section class="cat-header"><span>outros</span><strong><%= catOutros %>%</strong></section>
          <section class="cat-track"><section class="cat-fill" style="--cat-width: <%= catOutros %>%; background: #184C3B"></section></section>
        </section>
        <section class="cat-total">
          <p>total de anúncios</p>
          <strong><%= totalAnuncios.toLocaleString('pt-BR') %></strong>
        </section>
      </section>

    </section>
  </section>

</body>
</html>
