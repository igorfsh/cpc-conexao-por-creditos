<!DOCTYPE html>
<html lang="pt-BR" class="light conta-page">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Perfil</title>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Material+Symbols+Outlined:wght@100..700&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/conta.css" />
  <link rel="stylesheet" href="/css/footer.css">
</head>
<%- include('../partials/header.ejs') %>
 
<body>
  <main class="container">
    <section class="profile">
      <form class="profile-image" action="/conta/foto" method="POST" enctype="multipart/form-data">
        <label class="photo-trigger" for="fotoInput" title="Alterar foto de perfil">
          <img src="<%= usuario?.foto || '/img/img perfil-white.png' %>" alt="Foto de perfil de <%= usuario?.nome || 'usuário' %>" loading="lazy" id="fotoPerfil" />
        </label>
        <input id="fotoInput" name="foto" type="file" accept="image/jpeg,image/png,image/webp" hidden />
      </form>
      <section class="profile-header">
        <p class="profile-eyebrow">Minha conta</p>
        <h1><%= usuario?.nome || 'Usuário' %></h1>
        <p><%= usuario?.email || 'Sem e-mail cadastrado' %></p>
        <% if (usuario?.provider) { %>
          <span class="provider-label"><%= usuario.provider === 'local' ? 'Login local' : 'Entrou com ' + ({ google: 'Google', facebook: 'Facebook', linkedin: 'LinkedIn', apple: 'Apple', github: 'GitHub' }[usuario.provider] || usuario.provider) %></span>
        <% } %>
        <section class="passkey-panel" aria-labelledby="passkey-titulo">
          <section class="passkey-panel-header">
            <span class="passkey-icon material-symbols-outlined" aria-hidden="true">fingerprint</span>
            <span>
              <strong id="passkey-titulo">Acesso por biometria</strong>
              <span class="passkey-status <%= passkeys?.length ? 'is-active' : '' %>">
                <%= passkeys?.length ? `${passkeys.length} dispositivo${passkeys.length > 1 ? 's' : ''} ativo${passkeys.length > 1 ? 's' : ''}` : 'Ainda não ativado' %>
              </span>
            </span>
          </section>
          <p>Use a digital ou o Face ID para entrar sem digitar sua senha.</p>
          <button type="button" class="passkey-button" id="cadastrarBiometria" data-passkey-existente="<%= passkeys?.length ? 'true' : 'false' %>"<% if (locals.biometriaDisponivel === false) { %> data-indisponivel="true" disabled<% } %>>
            <span id="textoCadastroBiometria"><%= passkeys?.length ? 'Alterar chave de acesso' : 'Ativar Face ID ou biometria digital' %></span>
          </button>
          <p class="passkey-message" id="mensagemBiometria" role="status"></p>
        </section>
        <section class="balance-card" aria-label="Saldo de créditos">
          <span class="balance-icon material-symbols-outlined" aria-hidden="true"></span>
          <span class="balance-copy">
            <strong class="amount"><%= usuario?.creditos ?? 100 %></strong>
            <span class="balance-label">CRÉDITOS CPC</span>
          </span>
        </section>
      </section>
      <% if (locals.querySucesso) { %><p class="profile-message success">Foto atualizada com sucesso.</p><% } %>
      <% if (locals.queryErro) { %><p class="profile-message error">Não foi possível atualizar a foto. Use JPG, PNG ou WebP de até 5 MB.</p><% } %>
    </section>
 
      <!-- Bento Grid -->
      <section class="bento-grid">
        <!-- In-Progress Trades -->
        <section class="trades-section">
          <h2>Últimas Trocas</h2>
         
          <% if (meusTrocas && meusTrocas.length > 0) { %>
            <% meusTrocas.slice(0, 3).forEach(troca => { %>
              <% 
                const dataTroca = new Date(troca.dataSolicitacao);
                const dia = String(dataTroca.getDate()).padStart(2, '0');
                const mes = String(dataTroca.getMonth() + 1).padStart(2, '0');
                const ano = dataTroca.getFullYear();
                const dataFormatada = `${dia}/${mes}/${ano}`;
                const statusClasse = troca.status === 'concluida' ? 'status-concluido' : 'status-andamento';
                const statusTexto = troca.status === 'concluida' ? 'CONCLUÍDO' : 'ANDAMENTO';
              %>
              <a class="trade-card trade-card--link" href="/avaliacao#troca-<%= troca.id %>" aria-label="<%= troca.anuncioTitulo %> com <%= troca.doadorNome %>, <%= dataFormatada %>, <%= statusTexto.toLowerCase() %>. <%= troca.avaliacaoNota ? 'Ver avaliação' : 'Avaliar troca' %>">
                <section class="trade-icon">
                  <img src="<%= troca.fotoPerfil %>" alt="">
                </section>
                <section class="trade-info">
                  <p class="trade-type"><%= dataFormatada %></p>
                  <p class="trade-type"><%= troca.doadorNome %></p>
                  <p class="trade-name"><%= troca.anuncioTitulo %></p>
                </section>
                <section class="trade-status status-badge <%= statusClasse %>"><%= statusTexto %></section>
                <span class="trade-acao" aria-hidden="true"><%= troca.avaliacaoNota ? 'Ver avaliação' : 'Avaliar' %> ›</span>
              </a>
            <% }) %>
          <% } else { %>
            <section style="padding: 20px; text-align: center; color: #999;">
              <p>Nenhuma troca realizada ainda</p>
            </section>
          <% } %>
        </section>
       
        <section class="trades-section">
          <h2>Ofertas Ativas</h2>
          <% if (meusAnuncios && meusAnuncios.length > 0) { %>
            <% meusAnuncios.slice(0, 3).forEach(anuncio => { %>
              <% const dataAnuncio = new Date(anuncio.dataCriacao); %>
              <a class="trade-card trade-card--link" href="/contato/<%= anuncio.id %>" aria-label="Anúncio <%= anuncio.titulo %>, <%= anuncio.categoria %>, publicado em <%= dataAnuncio.toLocaleDateString('pt-BR') %>. Ver e editar anúncio">
                <section class="trade-icon">
                  <img src="<%= anuncio.fotoCapa %>" alt="">
                </section>
                <section class="trade-info">
                  <p class="trade-type"><%= dataAnuncio.toLocaleDateString('pt-BR') %></p>
                  <p class="trade-type"><%= anuncio.categoria %></p>
                  <p class="trade-name"><%= anuncio.titulo %></p>
                </section>
                <section class="trade-status status-badge status-ativa">ATIVA</section>
                <span class="trade-acao" aria-hidden="true">Ver / editar ›</span>
              </a>
            <% }) %>
          <% } else { %>
            <section style="padding: 20px; text-align: center; color: #999;">
              <p>Nenhum anúncio ativo ainda</p>
            </section>
          <% } %>
        </section>
      </section>

      <section class="dados-section" id="meus-dados" aria-labelledby="dados-titulo">
        <h2 id="dados-titulo">Meus dados</h2>
        <% if (locals.dadosSucesso) { %><p class="profile-message success" role="status">Dados atualizados com sucesso.</p><% } %>
        <% if (locals.dadosErro) { %><p class="profile-message error" role="alert"><%= dadosErro %></p><% } %>

        <form class="dados-form" action="/conta/dados" method="POST">
          <label class="dados-campo">
            <span>E-mail</span>
            <input type="email" name="email" value="<%= usuario?.email || '' %>" required autocomplete="email" />
          </label>
          <label class="dados-campo">
            <span>Telefone</span>
            <input type="tel" name="telefone" id="telefoneConta" value="<%= usuario?.telefone || '' %>" placeholder="(11) 91234-5678" autocomplete="tel" inputmode="tel" maxlength="20" />
          </label>
          <label class="dados-campo dados-campo--largo">
            <span>Endereço</span>
            <input type="text" name="endereco" value="<%= usuario?.endereco || '' %>" placeholder="Rua, número, bairro, cidade - UF" autocomplete="street-address" maxlength="255" />
            <small class="dados-dica">Seu endereço completo fica privado. Nos anúncios aparece só a cidade e o estado (ex.: Barueri-SP).</small>
          </label>
          <button type="submit" class="dados-salvar">Salvar alterações</button>
        </form>

        <section class="dados-perigo">
          <span>
            <strong>Excluir conta</strong>
            <p>Sua conta e todos os seus anúncios serão apagados permanentemente.</p>
          </span>
          <button type="button" class="dados-excluir" id="abrirExcluirConta">Excluir conta</button>
        </section>
      </section>
  </main>

  <dialog class="excluir-dialog" id="excluirContaDialog" aria-labelledby="excluir-titulo">
    <form action="/conta/excluir" method="POST">
      <h3 id="excluir-titulo">Excluir sua conta?</h3>
      <p>Essa ação não pode ser desfeita. <strong><%= meusAnuncios?.length || 0 %> anúncio<%= meusAnuncios?.length === 1 ? '' : 's' %></strong> também <%= meusAnuncios?.length === 1 ? 'será excluído' : 'serão excluídos' %>.</p>
      <label class="dados-campo">
        <span>Digite <strong>EXCLUIR</strong> para confirmar</span>
        <input type="text" id="confirmarExclusao" autocomplete="off" />
      </label>
      <section class="excluir-acoes">
        <button type="button" class="dados-cancelar" id="cancelarExcluirConta">Cancelar</button>
        <button type="submit" class="dados-excluir" id="confirmarExcluirConta" disabled>Excluir definitivamente</button>
      </section>
    </form>
  </dialog>
 
   <!-- Logout -->
    <section class="logout-section">
      <a href="/logout" class="logout-btn">Sair da Conta</a>
    </section>
 
    <%- include('../partials/footer.ejs') %>
    <script>
      (function () {
        var input = document.getElementById('fotoInput');
        var preview = document.getElementById('fotoPerfil');
        var formulario = input && input.form;
        if (!input || !preview || !formulario) return;
        input.addEventListener('change', function () {
          var arquivo = input.files && input.files[0];
          if (!arquivo) return;
          if (!arquivo.type.startsWith('image/') || arquivo.size > 5 * 1024 * 1024) {
            input.value = '';
            alert('Escolha uma imagem de até 5 MB.');
            return;
          }
          preview.src = URL.createObjectURL(arquivo);
          formulario.submit();
        });
      })();
    </script>
    <script>
      (function () {
        var dialog = document.getElementById('excluirContaDialog');
        var abrir = document.getElementById('abrirExcluirConta');
        var cancelar = document.getElementById('cancelarExcluirConta');
        var campo = document.getElementById('confirmarExclusao');
        var confirmar = document.getElementById('confirmarExcluirConta');
        if (!dialog || !abrir) return;
        abrir.addEventListener('click', function () {
          campo.value = '';
          confirmar.disabled = true;
          dialog.showModal();
          campo.focus();
        });
        cancelar.addEventListener('click', function () { dialog.close(); });
        campo.addEventListener('input', function () {
          confirmar.disabled = campo.value.trim().toUpperCase() !== 'EXCLUIR';
        });
      })();
    </script>
    <script src="/js/telefone.js"></script>
    <script>
      (function () {
        var campo = document.getElementById('telefoneConta');
        if (!campo || !window.CPCTelefone) return;
        function validar() {
          var r = CPCTelefone.validarTelefone(campo.value);
          campo.setCustomValidity(!campo.value || r.valido ? '' : r.erro);
        }
        campo.addEventListener('input', function () {
          campo.value = CPCTelefone.mascararTelefone(campo.value);
          validar();
        });
        validar();
      })();
    </script>
    <script src="/js/passkeys.js"></script>
</body>
</html>