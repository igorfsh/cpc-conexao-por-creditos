<% const inicial = usuarioLogado ? usuarioLogado.nome.charAt(0).toUpperCase() : 'A'; %>
<section class="topbar">
  <section class="topbar-left">
    <a href="/adm/usuarios" class="topbar-user mobile-only-user"><%= inicial %></a>

    <a class="topbar-logo" href="/">
      <img src="/img/logo-white.png" alt="CPC">
      <span>admin</span>
    </a>
  </section>

  <nav class="topbar-nav side-menu">
    <ul>
      <li>
        <a href="/adm" class="<%= ativo === 'dashboard' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          Dashboard
        </a>
      </li>
      <li>
        <a href="/adm/anuncios" class="<%= ativo === 'anuncios' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24"><path d="M11 5H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-5"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          Anúncios
        </a>
      </li>
      <li>
        <a href="/adm/trocas" class="<%= ativo === 'trocas' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24"><path d="M7 16V4m0 0L3 8m4-4l4 4"/><path d="M17 8v12m0 0l4-4m-4 4l-4-4"/></svg>
          Trocas
        </a>
      </li>
      <li>
        <a href="/adm/usuarios" class="<%= ativo === 'usuarios' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Usuários
        </a>
      </li>
      <li class="mobile-only-logout">
        <a href="/logout">
          <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Sair
        </a>
      </li>
    </ul>
  </nav>

  <section class="hamburger mobile-menu" id="hamburger">
    <span></span>
    <span></span>
    <span></span>
  </section>

  <section class="topbar-right desktop-only-right">
    <span class="topbar-badge">● sistema ativo</span>
    <a href="/logout" class="topbar-logout" title="Sair da conta">Sair</a>
    <section class="topbar-user"><%= inicial %></section>
  </section>
</section>

<section class="overlay" id="overlay"></section>

<script src="/js/menu.js"></script>
<%- include('acessibilidade.ejs') %>

<% if (typeof mensagem !== 'undefined' && mensagem) { %>
  <section class="adm-alert adm-alert-<%= mensagem.tipo %>" role="status"><%= mensagem.texto %></section>
<% } %>
