<link rel="icon" href="../img/logo-black.png">
<link rel="stylesheet" href="../css/header.css">              
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#184c3b">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<link rel="apple-touch-icon" href="/img/icons/icon-green-192.png">
<header class="main-header">
    <section class="header-container">
 
        <!-- LOGIN MOBILE -->
        <% if (!usuarioLogado) { %>
            <a href="/login" class="login mobile-login">LOGIN</a>
        <% } else { %>
            <a href="/conta" class="login mobile-login"><img src="<%= usuarioLogado.foto || '/img/img perfil-white.png' %>" alt="Perfil" class="perfil-img"></a>
        <% } %>

        <!-- LOGO -->
        <section class="logo">
            <a href="/">
                <img src="/img/logo-white.png" alt="CPC Logo">
            </a>
        </section>
 
        <!-- MENU DESKTOP -->
        <nav class="desktop-menu">
            <ul>
                <li><a href="/">INÍCIO</a></li>
                <li><a href="/doe">DOAR</a></li>
                <li><a href="/servicos">TROCAR ITENS</a></li>
                <li><a href="/comofunciona">COMO FUNCIONA</a></li>
                <li><a href="/sobrenos">SOBRE NÓS</a></li>
                <li><a href="/saibamais">SAIBA MAIS</a></li>
                <!-- <li><a href="/noticia">NOTÍCIAS</a></li> -->
            </ul>
        </nav>
 
        <!-- AÇÕES DESKTOP -->
        <section class="desktop-actions">
            <% if (!usuarioLogado) { %>
                <a href="/login" class="login">LOGIN</a>
            <% } else { %>
                <a href="/conta" class="perfil-icon" title="Meu Perfil"><img src="<%= usuarioLogado.foto || '/img/img perfil-white.png' %>" alt="Perfil" class="perfil-img"></a>
            <% } %>
        </section>
 
        <!-- HAMBURGER MOBILE -->
        <section class="hamburger mobile-menu" id="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </section>
 
    </section>
</header>
 
<script src="/js/menu.js"></script>
 
<!-- OVERLAY -->
<section class="overlay" id="overlay"></section>
 
<!-- MENU LATERAL MOBILE -->
<nav class="side-menu" id="sideMenu">
    <ul>
        <li><a href="/">INÍCIO</a></li>
        <li><a href="/doe">DOAR</a></li>
        <li><a href="/servicos">TROCAR ITENS</a></li>
        <li><a href="/comofunciona">COMO FUNCIONA</a></li>
        <li><a href="/sobrenos">SOBRE NÓS</a></li>
        <li><a href="/saibamais">SAIBA MAIS</a></li>
        <!--<li><a href="/noticia">NOTÍCIAS</a></li>-->
        <% if (usuarioLogado) { %>
            <li><a href="/conta">MINHA CONTA</a></li>
            <li><a href="/logout">SAIR</a></li>
        <% } %>
    </ul>
</nav>

<aside class="pwa-install" id="pwa-install" aria-labelledby="pwa-install-title" hidden>
    <div class="pwa-install__content">
        <strong id="pwa-install-title">Leve o CPC com você</strong>
        <p>Instale o app na tela inicial para acessar a rede de trocas com mais rapidez.</p>
    </div>
    <div class="pwa-install__actions">
        <button class="pwa-install__button" id="pwa-install-button" type="button">Adicionar à tela inicial</button>
        <button class="pwa-install__close" id="pwa-install-close" type="button" aria-label="Fechar convite de instalação">&times;</button>
    </div>
</aside>

<%- include('acessibilidade.ejs') %>
<%- include('chat-ia.ejs') %>
<script src="/js/pwa.js" defer></script>